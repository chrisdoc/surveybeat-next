{
  "name": "surveybeat",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node scripts/typecheck/run.mjs",
    "typecheck:tsc": "effect-tsgo tsc -b",
    "typecheck:effect": "effect-tsgo tsc -b",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm check:ledger && pnpm check:comments",
    "check:ledger": "node scripts/ledger/diagnostics-ledger.mjs",
    "check:comments": "node scripts/ledger/comment-debt.mjs",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --project unit",
    "test:privacy": "vitest run --project privacy",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=test-report.junit.xml",
    "env:check": "varlock load",
    "test:e2e": "varlock run -- pnpm --filter @surveybeat/infra test:e2e",
    "test:lighthouse": "pnpm --filter @surveybeat/infra test:lighthouse",
    "test:preview-privacy": "node infra/tests/privacy/canary-sweep.ts",
    "infra:deploy": "varlock run -- alchemy deploy infra/alchemy.run.ts",
    "infra:destroy": "alchemy destroy infra/alchemy.run.ts",
    "check:observability": "node infra/scripts/check-observability.ts",
    "prepare": "node scripts/fence/install.mjs && effect-tsgo patch --typescript",
    "typecheck:parity": "node scripts/typecheck/parity.mjs",
    "typecheck:fast": "node scripts/typecheck/run.mjs --fast",
    "bump:checkers": "node scripts/typecheck/bump.mjs"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@foldkit/oxlint-plugin": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@xstate/effect": "catalog:",
    "@yielded/effect-tsrs": "catalog:",
    "alchemy": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "varlock": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
