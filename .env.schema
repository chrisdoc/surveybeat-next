# Varlock schema for SurveyBeat. This file is committed and documents every variable the
# deploy, the e2e suite and the stage scripts read. Real values go in `.env.local`, which is
# not committed. `pnpm env:check` validates both; `pnpm infra:deploy` and `pnpm test:e2e` run
# under `varlock run`, so a missing or malformed value fails before Alchemy or Playwright starts.
# Nothing here is required: a fresh clone can run the unit tests and the local e2e stage.
# @defaultSensitive=false
# @defaultRequired=false
# ---
# The Cloudflare API token the deploy and the stage scripts (check:observability,
# test:preview-privacy) need. Only used from a shell, never bound into a Worker.
# @sensitive
CLOUDFLARE_API_TOKEN=

# The Cloudflare account that holds the SurveyBeat stages.
CLOUDFLARE_ACCOUNT_ID=

# Optional. Bound into the Main Worker as a secret; AI features fail closed
# (AiNotConfigured) without it. Account settings and EU-only routing are per ADR 0015.
# @sensitive
OPENROUTER_API_KEY=

# Optional. Points the Playwright suite at a deployed stage
# (https://pr-<n>.dashboard.surveybeat.app). Unset, it runs a local stage instead.
# @type=url
E2E_BASE_URL=

# Optional. Overrides the allowlist in infra/org-creation-allowlist.yaml for a stage that
# builds its own environment (the e2e stack sets it). Comma-separated verified emails.
ORG_CREATION_ALLOWLIST=
